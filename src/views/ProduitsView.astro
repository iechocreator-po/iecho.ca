---
import Base from '../layouts/Base.astro';
import ProductExplorer from '../components/ProductExplorer.astro';
import { t, type Langue } from '../i18n/ui';

import produitsFr from '../data/produits/fr.json';
import produitsEn from '../data/produits/en.json';
import produitsEs from '../data/produits/es.json';

const parLangue = { fr: produitsFr, en: produitsEn, es: produitsEs } as const;

interface Props {
  lang: Langue;
}
const { lang } = Astro.props;
const tr = t(lang);
const produits = parLangue[lang];
---
<Base lang={lang} page="produits" titre={tr('produits.titre')}>
  <div class="hero">
    <svg class="hero-ondes" width="260" height="260" viewBox="0 0 260 260" fill="none" aria-hidden="true">
      {[30, 55, 80, 105, 130].map((r, i) => (
        <circle cx="130" cy="130" r={r} stroke="var(--accent)" stroke-opacity={0.22 - i * 0.04} stroke-width="1" />
      ))}
    </svg>
    <h1>iecho <span style="color: var(--texte-3); font-weight: 400;">— {tr('site.tagline')}</span></h1>
    <p>{tr('produits.intro')}</p>
  </div>
  <ProductExplorer lang={lang} produits={produits} />
</Base>
