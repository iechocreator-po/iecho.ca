---
// Navigation horizontale entre produits (cartes à vignette) + panneau de détail.
// Contenu : src/data/produits/<lang>.json.
// Captures : déposer les images dans public/captures/ nommées <id>-1.png,
// <id>-2.png, … (png/jpg/webp). La -1 sert de vignette au bouton, toutes
// apparaissent dans la galerie de la fiche. Détection au moment du build.
import fs from 'node:fs';
import path from 'node:path';
import { t, type Langue } from '../i18n/ui';
import config from '../data/produits.config.json';

interface Produit {
  id: string;
  nom: string;
  sousTitre: string;
  resume: string;
  besoin: string;
  lien?: string;
  stack: string[];
  roadmap: { titre: string; statut: 'proposee' | 'encours' | 'livree' }[];
}

interface Props {
  lang: Langue;
  produits: Produit[];
}
const { lang, produits: produitsBruts } = Astro.props;
const tr = t(lang);

// Ordre d'affichage piloté par produits.config.json ; un produit absent de la
// liste est placé à la fin (ordre stable d'origine).
const ordre: string[] = config.ordre ?? [];
const rang = (id: string) => {
  const i = ordre.indexOf(id);
  return i === -1 ? ordre.length : i;
};
const produits = [...produitsBruts].sort((a, b) => rang(a.id) - rang(b.id));

// Produits dont la section technique (« Sous le capot ») est affichée.
const afficherTechnique = new Set<string>(config.afficherTechnique ?? []);

const dossierCaptures = path.resolve('./public/captures');
function capturesPour(id: string): string[] {
  if (!fs.existsSync(dossierCaptures)) return [];
  const motif = new RegExp(`^${id}-\\d+\\.(png|jpe?g|webp)$`, 'i');
  return fs
    .readdirSync(dossierCaptures)
    .filter((f) => motif.test(f))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
    .map((f) => `/captures/${f}`);
}
const captures = Object.fromEntries(produits.map((p) => [p.id, capturesPour(p.id)]));

const libelleStatut = {
  proposee: tr('statut.proposee'),
  encours: tr('statut.encours'),
  livree: tr('statut.livree'),
};
---
<div class="onglets-produits" role="tablist" aria-label={tr('produits.titre')}>
  {produits.map((p) => (
    <button
      class="onglet-produit"
      role="tab"
      id={`onglet-${p.id}`}
      aria-selected="false"
      aria-controls={`panneau-${p.id}`}
      data-produit={p.id}
    >
      {captures[p.id].length > 0 ? (
        <img class="vignette" src={captures[p.id][0]} alt="" loading="lazy" />
      ) : (
        <span class="vignette vignette-vide" aria-hidden="true">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
            <circle cx="32" cy="32" r="6" fill="var(--accent)" fill-opacity="0.8" />
            <circle cx="32" cy="32" r="15" stroke="var(--accent)" stroke-opacity="0.4" stroke-width="1.5" />
            <circle cx="32" cy="32" r="24" stroke="var(--accent)" stroke-opacity="0.18" stroke-width="1.5" />
          </svg>
        </span>
      )}
      <span class="nom">{p.nom}</span>
    </button>
  ))}
</div>

{produits.map((p) => (
  <section
    class="panneau-produit"
    role="tabpanel"
    id={`panneau-${p.id}`}
    aria-labelledby={`onglet-${p.id}`}
    hidden
  >
    <h2>{p.nom}</h2>
    <p class="sous-titre">{p.sousTitre}</p>
    <p class="resume">{p.resume}</p>
    {p.lien && (
      <a class="bouton-essayer" href={p.lien} target="_blank" rel="noopener">
        {tr('produit.essayer')} {p.nom}
      </a>
    )}

    <div class="section-produit">
      <h3>{tr('produit.besoin')}</h3>
      <p>{p.besoin}</p>
    </div>

    <div class="section-produit">
      <h3>{tr('produit.captures')}</h3>
      {captures[p.id].length > 0 ? (
        <div class="captures">
          {captures[p.id].map((src, n) => (
            <a href={src} target="_blank" rel="noopener">
              <img src={src} alt={`${p.nom} — ${tr('produit.captures')} ${n + 1}`} loading="lazy" />
            </a>
          ))}
        </div>
      ) : (
        <p class="captures-vide">{tr('produit.captures.bientot')}</p>
      )}
    </div>

    {afficherTechnique.has(p.id) && (
      <div class="section-produit">
        <h3>{tr('produit.technique')}</h3>
        <ul class="pastilles">
          {p.stack.map((tech) => <li>{tech}</li>)}
        </ul>
      </div>
    )}

    <div class="section-produit">
      <h3>{tr('produit.roadmap')}</h3>
      <ul class="roadmap">
        {p.roadmap.map((f) => (
          <li>
            <span class={`statut statut-${f.statut}`}>{libelleStatut[f.statut]}</span>
            {f.titre}
          </li>
        ))}
      </ul>
    </div>
  </section>
))}

<script>
  const onglets = document.querySelectorAll<HTMLButtonElement>('.onglet-produit');

  function activer(onglet: HTMLButtonElement) {
    onglets.forEach((o) => {
      const actif = o === onglet;
      o.setAttribute('aria-selected', String(actif));
      const panneau = document.getElementById(o.getAttribute('aria-controls')!);
      if (panneau) panneau.hidden = !actif;
    });
  }

  onglets.forEach((onglet) => {
    onglet.addEventListener('click', (e) => {
      activer(onglet);
      // Amène la fiche du produit dans le champ de vision.
      document
        .getElementById(onglet.getAttribute('aria-controls')!)
        ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      // Onde concentrique au point de clic — le motif écho.
      const rect = onglet.getBoundingClientRect();
      const onde = document.createElement('span');
      onde.className = 'onde-clic';
      const taille = Math.max(rect.width, rect.height) * 2;
      onde.style.width = onde.style.height = `${taille}px`;
      onde.style.left = `${e.clientX - rect.left}px`;
      onde.style.top = `${e.clientY - rect.top}px`;
      onglet.appendChild(onde);
      onde.addEventListener('animationend', () => onde.remove());
    });
  });

  // Navigation clavier gauche/droite entre les onglets.
  document.querySelector('.onglets-produits')?.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent;
    if (ke.key !== 'ArrowRight' && ke.key !== 'ArrowLeft') return;
    const liste = Array.from(onglets);
    const courant = liste.findIndex((o) => o.getAttribute('aria-selected') === 'true');
    const suivant = ke.key === 'ArrowRight'
      ? (courant + 1) % liste.length
      : (courant - 1 + liste.length) % liste.length;
    activer(liste[suivant]);
    liste[suivant].focus();
  });
</script>
