---
// Marque iecho : ondes concentriques. Les cercles extérieurs pulsent au survol
// du lien parent (.marque), via les classes .onde-2 / .onde-3.
interface Props {
  taille?: number;
}
const { taille = 26 } = Astro.props;
---
<svg
  width={taille}
  height={taille}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <circle cx="16" cy="16" r="3.5" fill="var(--accent)" />
  <circle class="onde-2" cx="16" cy="16" r="8.5" stroke="var(--accent)" stroke-opacity="0.55" stroke-width="1.5" style="transform-origin: center;" />
  <circle class="onde-3" cx="16" cy="16" r="14" stroke="var(--accent)" stroke-opacity="0.25" stroke-width="1.5" style="transform-origin: center;" />
</svg>
