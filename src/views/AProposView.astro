---
import Base from '../layouts/Base.astro';
import { t, type Langue } from '../i18n/ui';

interface Props {
  lang: Langue;
}
const { lang } = Astro.props;
const tr = t(lang);
---
<Base lang={lang} page="apropos" titre={tr('apropos.titre')}>
  <div class="prose">
    <h1>{tr('apropos.titre')}</h1>
    <p>{tr('apropos.bio.1')}</p>
    <p>{tr('apropos.bio.3')}</p>
    <p>{tr('apropos.bio.4')}</p>
    <p>{tr('apropos.bio.5')}</p>

    <h2>{tr('apropos.collabs')}</h2>
    <p>{tr('apropos.bio.2')}</p>
    <p>{tr('apropos.collabs.brouillon')}</p>

    <h2>{tr('apropos.perso')}</h2>
    <p>{tr('apropos.perso.brouillon')}</p>
  </div>
</Base>
