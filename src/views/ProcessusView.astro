---
// Processus de création. La galerie « Logos en gestation » vit désormais dans
// le Journal (entrée du 2026-07-10, voir JournalView.astro).
import Base from '../layouts/Base.astro';
import InfographieProcessus from '../components/InfographieProcessus.astro';
import { t, type Langue } from '../i18n/ui';

interface Props {
  lang: Langue;
}
const { lang } = Astro.props;
const tr = t(lang);
---
<Base lang={lang} page="processus" titre={tr('processus.titre')}>
  <div class="prose">
    <h1>{tr('processus.titre')}</h1>
    <p class="intro-processus">{tr('processus.intro')}</p>
  </div>

  {/* Hors de .prose (colonne de texte de 42rem) pour occuper la largeur utile
      de <main>. L'infographie porte visuellement l'essentiel ; elle est
      aria-hidden et masquée sous 720 px, où son texte deviendrait illisible. */}
  <figure class="infographie">
    <InfographieProcessus lang={lang} />
  </figure>

  <div class="prose">
    <p>{tr('processus.echo')}</p>
  </div>
</Base>
