---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { t, type Langue } from '../i18n/ui';
import data from '../data/journal/entries.json';

interface Props {
  lang: Langue;
}
const { lang } = Astro.props;
const tr = t(lang);

type Entree = (typeof data.entries)[number];
// Plus récente d'abord ; à date égale, l'ordre du fichier fait foi.
const entrees = [...data.entries].sort((a, b) => b.date.localeCompare(a.date));
const produits = [...new Set(entrees.map((e) => e.produit))];
const mois = new Intl.DateTimeFormat(lang, { month: 'long', year: 'numeric', timeZone: 'UTC' });
const jour = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const texte = (e: Entree) => (e as any)[lang] ?? e.fr;
const groupes: { cle: string; libelle: string; items: Entree[] }[] = [];
for (const e of entrees) {
  const cle = e.date.slice(0, 7);
  let g = groupes.find((x) => x.cle === cle);
  if (!g) {
    g = { cle, libelle: mois.format(new Date(e.date + 'T12:00:00Z')), items: [] };
    groupes.push(g);
  }
  g.items.push(e);
}

// Galerie « Logos en gestation » : planches déposées dans public/logos/, nommées
// logo-n<niveau>-<planche>-<quadrant>.png (script de découpe) ou logo-n<niveau>-<n>.png.
// Groupées par niveau, une rangée horizontale par niveau.
const dossierLogos = path.resolve('./public/logos');
const motifLogo = /^logo-n(\d+)-.+\.(png|jpe?g|webp|svg)$/i;
const fichiersLogos = fs.existsSync(dossierLogos)
  ? fs.readdirSync(dossierLogos).filter((f) => motifLogo.test(f)).sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
  : [];
const niveaux = new Map<number, string[]>();
for (const f of fichiersLogos) {
  const n = Number(f.match(motifLogo)![1]);
  if (!niveaux.has(n)) niveaux.set(n, []);
  niveaux.get(n)!.push(`/logos/${f}`);
}
// Niveau 4 : trois pistes dessinées en SVG, indépendantes des fichiers déposés.
const niveau4Svg = [
  { id: 'logo-a', rayons: [4, 9, 14], opacites: [1, 0.5, 0.22] },
  { id: 'logo-b', rayons: [3, 7, 11, 15], opacites: [1, 0.65, 0.38, 0.16] },
  { id: 'logo-c', rayons: [5, 12], opacites: [1, 0.35] },
];
niveaux.set(4, niveaux.get(4) ?? []);
const ordreNiveaux = Array.from(niveaux.keys()).sort((a, b) => a - b);
---
<Base lang={lang} page="journal" titre={tr('journal.titre')} description={tr('journal.intro')}>
  <section class="journal-tete">
    <p class="journal-eyebrow">{tr('journal.eyebrow')}</p>
    <h1>{tr('journal.titre.h1')}</h1>
    <p class="journal-intro">{tr('journal.intro')}</p>
    <p class="journal-meta">
      <a href="/journal.xml">{tr('journal.rss')}</a>
      {lang !== 'fr' && <span> · {tr('journal.langue.note')}</span>}
    </p>
  </section>

  <div class="journal-corps">
    <div class="journal-fil">
      <div class="journal-filtres">
        <div role="group" aria-label={tr('journal.filtre.produit')} class="journal-chips" data-filtre="produit">
          <button type="button" class="journal-chip" aria-pressed="true" data-valeur="">{tr('journal.tous')}</button>
          {produits.map((p) => <button type="button" class="journal-chip" aria-pressed="false" data-valeur={p}>{p}</button>)}
        </div>
        <div role="group" aria-label={tr('journal.filtre.type')} class="journal-chips" data-filtre="type">
          <button type="button" class="journal-chip journal-chip-ambre" aria-pressed="true" data-valeur="">{tr('journal.tout')}</button>
          <button type="button" class="journal-chip journal-chip-ambre" aria-pressed="false" data-valeur="livre">{tr('journal.type.livre')}</button>
          <button type="button" class="journal-chip journal-chip-ambre" aria-pressed="false" data-valeur="anticipe">{tr('journal.type.anticipe')}</button>
          <button type="button" class="journal-chip journal-chip-ambre" aria-pressed="false" data-valeur="decouverte">{tr('journal.type.decouverte')}</button>
        </div>
      </div>

      {groupes.map((g, i) => (
        <details class="journal-mois" data-mois open={i === 0} data-defaut={i === 0 ? 'ouvert' : 'ferme'}>
          <summary><h2>{g.libelle}</h2><span class="journal-compte">{g.items.length}</span></summary>
          {g.items.map((e) => (
            <article id={e.id} class={`journal-entree journal-${e.type}`} data-produit={e.produit} data-type={e.type}>
              <div class="journal-date">
                <time datetime={e.date}>{jour.format(new Date(e.date + 'T12:00:00Z'))}</time>
                <span class={`journal-badge journal-badge-${e.type}`}>{tr(`journal.type.${e.type}` as any)}</span>
              </div>
              <div class="journal-contenu">
                <p class="journal-produit">{e.produit}</p>
                <h3>{texte(e).titre}</h3>
                <p>{texte(e).resume}</p>
                {(texte(e) as any).corps && (
                  <details class="journal-maquette journal-article">
                    <summary>{tr('journal.article.lire')}</summary>
                    <div class="journal-article-corps">
                      {((texte(e) as any).corps as string[]).map((b) => (
                        b.startsWith('# ') ? <h4>{b.slice(2)}</h4> : <p>{b}</p>
                      ))}
                    </div>
                  </details>
                )}
                {(e as any).galerie === 'logos' && (
                  <details class="journal-maquette">
                    <summary>{tr('journal.logos.voir')}</summary>
                    {ordreNiveaux.map((niveau) => (
                      <div class="niveau-logos">
                        <div class="logos-gestation">
                          {niveaux.get(niveau)!.map((src) => (
                            <div class="logo-carte"><img src={src} alt="" loading="lazy" /></div>
                          ))}
                          {niveau === 4 && niveau4Svg.map((v) => (
                            <div class="logo-carte">
                              <svg width="72" height="72" viewBox="0 0 36 36" fill="none" aria-hidden="true">
                                {v.rayons.map((r, i) => (
                                  i === 0
                                    ? <circle cx="18" cy="18" r={r} fill="var(--accent)" fill-opacity={v.opacites[i]} />
                                    : <circle cx="18" cy="18" r={r} stroke="var(--accent)" stroke-opacity={v.opacites[i]} stroke-width="1.5" />
                                ))}
                              </svg>
                            </div>
                          ))}
                        </div>
                      </div>
                    ))}
                  </details>
                )}
                {e.maquette && (
                  <details class="journal-maquette">
                    <summary>{tr('journal.maquette.voir')}</summary>
                    <p class="journal-meta">{tr('journal.maquette.note')}</p>
                    <iframe src={e.maquette} sandbox="" loading="lazy" title={texte(e).titre}></iframe>
                  </details>
                )}
              </div>
            </article>
          ))}
        </details>
      ))}
      <p class="journal-vide" id="journal-vide" hidden>{tr('journal.vide')}</p>
    </div>
  </div>
</Base>

<script>
  // Filtres : on masque les entrées qui ne correspondent pas, puis les mois devenus vides.
  const etat: Record<string, string> = { produit: '', type: '' };
  const entrees = document.querySelectorAll<HTMLElement>('.journal-entree');
  function ouvrirCible() {
    const cible = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
    const mois = cible && cible.closest('details');
    if (mois) (mois as HTMLDetailsElement).open = true;
  }
  function appliquer() {
    const filtre = !!(etat.produit || etat.type);
    entrees.forEach((el) => {
      const ok = (!etat.produit || el.dataset.produit === etat.produit) && (!etat.type || el.dataset.type === etat.type);
      el.hidden = !ok;
    });
    let visibles = 0;
    document.querySelectorAll<HTMLElement>('[data-mois]').forEach((m) => {
      const n = m.querySelectorAll('.journal-entree:not([hidden])').length;
      m.hidden = n === 0;
      visibles += n;
      // Filtre actif : on déplie les mois qui ont des résultats ; sinon, retour à l'état par défaut.
      (m as HTMLDetailsElement).open = filtre ? n > 0 : m.dataset.defaut === 'ouvert';
    });
    ouvrirCible();
    const vide = document.getElementById('journal-vide');
    if (vide) vide.hidden = visibles > 0;
  }
  ouvrirCible();
  window.addEventListener('hashchange', ouvrirCible);
  document.querySelectorAll<HTMLElement>('.journal-chips').forEach((groupe) => {
    groupe.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest('button');
      if (!b) return;
      etat[groupe.dataset.filtre as string] = b.dataset.valeur ?? '';
      groupe.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      appliquer();
    });
  });
</script>

<style>
  .journal-tete { max-width: 62ch; padding: 2.5rem 0 1.5rem; }
  .journal-eyebrow { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ambre); font-weight: 700; margin-bottom: 0.6rem; }
  .journal-tete h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); line-height: 1.15; margin-bottom: 0.9rem; }
  .journal-intro { color: var(--texte-2); line-height: 1.6; }
  .journal-meta { font-size: 0.85rem; color: var(--texte-3); margin-top: 0.6rem; }
  .journal-article-corps h4 { margin: 1.1rem 0 0.3rem; font-size: 0.95rem; color: var(--accent); }
  .journal-article-corps p { margin: 0 0 0.7rem; line-height: 1.6; }
  .journal-corps { display: flex; flex-wrap: wrap; gap: 2.5rem; align-items: flex-start; padding-bottom: 4rem; }
  .journal-fil { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 1.6rem; }
  .journal-filtres { display: flex; flex-wrap: wrap; gap: 1.2rem; }
  .journal-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .journal-chip { font: inherit; font-size: 0.82rem; padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid var(--bordure); background: transparent; color: var(--texte-2); cursor: pointer; }
  .journal-chip[aria-pressed='true'] { border-color: var(--accent); background: var(--accent-doux); color: var(--accent-vif); }
  .journal-chip-ambre[aria-pressed='true'] { border-color: var(--ambre); background: var(--ambre-doux); color: var(--ambre); }
  .journal-mois[open] { display: flex; flex-direction: column; gap: 1.6rem; }
  .journal-mois > summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer; list-style: none; border-bottom: 1px solid var(--bordure); padding-bottom: 0.6rem; }
  .journal-mois > summary::-webkit-details-marker { display: none; }
  .journal-mois > summary::before { content: '▸'; color: var(--texte-3); margin-right: 0.5rem; transition: transform 0.15s; }
  .journal-mois[open] > summary::before { transform: rotate(90deg); }
  .journal-mois > summary h2 { flex: 1; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--texte-2); font-weight: 600; }
  .journal-compte { font-size: 0.75rem; color: var(--texte-3); }
  .journal-entree { display: flex; flex-wrap: wrap; gap: 1.2rem; }
  .journal-entree[hidden], .journal-mois[hidden] { display: none; }
  .journal-date { flex: 0 0 7.5rem; display: flex; flex-direction: column; gap: 0.4rem; font-weight: 600; font-size: 0.9rem; }
  .journal-badge { align-self: flex-start; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; padding: 0.15rem 0.5rem; border-radius: 5px; }
  .journal-badge-livre { color: var(--vert); background: var(--vert-doux); }
  .journal-badge-decouverte { color: var(--accent-vif); background: var(--accent-doux); }
  .journal-badge-anticipe { color: var(--ambre); background: var(--ambre-doux); }
  .journal-contenu { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 0.6rem; padding-left: 1.3rem; border-left: 2px solid var(--bordure); }
  .journal-anticipe .journal-contenu { border-left-color: var(--ambre); }
  .journal-produit { font-size: 0.8rem; color: var(--accent); font-weight: 600; }
  .journal-contenu h3 { font-size: 1.25rem; line-height: 1.3; }
  .journal-contenu p { color: var(--texte-2); line-height: 1.65; }
  .journal-maquette summary { cursor: pointer; color: var(--accent); font-size: 0.9rem; }
  .journal-maquette iframe { width: 100%; height: 640px; border: 1px dashed var(--bordure-vive); border-radius: var(--rayon); background: var(--fond); margin-top: 0.6rem; }
  .journal-vide { color: var(--texte-2); }
</style>
